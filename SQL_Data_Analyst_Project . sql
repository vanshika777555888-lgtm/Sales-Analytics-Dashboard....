-- QUERY 38
-- Calculate total sales revenue
SELECT
   ROUND(SUM(p.price * oi.quantity), 2) AS total_sales_revenue
FROM orders o
JOIN order_items oi
   ON o.order_id = oi.order_id
JOIN products p
   ON oi.product_id = p.product_id;


-- QUERY 39
-- Calculate total profit
SELECT
   ROUND(SUM((p.price - p.cost) * oi.quantity), 2) AS total_profit
FROM order_items oi
JOIN products p
   ON oi.product_id = p.product_id;


-- QUERY 40
-- Calculate sales revenue and profit by category
SELECT
   p.category,
   ROUND(SUM(p.price * oi.quantity), 2) AS total_sales,
   ROUND(SUM((p.price - p.cost) * oi.quantity), 2) AS total_profit
FROM order_items oi
JOIN products p
   ON oi.product_id = p.product_id
GROUP BY p.category
ORDER BY total_sales DESC;


-- QUERY 41
-- Calculate total spending by customer
