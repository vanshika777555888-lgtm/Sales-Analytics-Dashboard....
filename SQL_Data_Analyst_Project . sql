-- QUERY 61
-- Compare monthly sales with the previous month
WITH monthly_sales AS (
   SELECT
     DATE_TRUNC('month', o.order_date) AS sales_month,
     SUM(p.price * oi.quantity) AS total_sales
   FROM orders o
   JOIN order_items oi
     ON o.order_id = oi.order_id
   JOIN products p
     ON oi.product_id = p.product_id
   GROUP BY DATE_TRUNC('month', o.order_date)
)

SELECT
  sales_month,
  ROUND(total_sales, 2) AS current_month_sales,
  ROUND(
     LAG(total_sales) OVER (ORDER BY sales_month),
     2
  ) AS previous_month_sales
FROM monthly_sales
ORDER BY sales_month;


-- QUERY 62
-- Compare monthly sales with the next month
WITH monthly_sales AS (
   SELECT
     DATE_TRUNC('month', o.order_date) AS sales_month,
     SUM(p.price * oi.quantity) AS total_sales
   FROM orders o
   JOIN order_items oi
     ON o.order_id = oi.order_id
   JOIN products p
     ON oi.product_id = p.product_id
   GROUP BY DATE_TRUNC('month', o.order_date)
)

SELECT
  sales_month,
  ROUND(total_sales, 2) AS current_month_sales,
  ROUND(
     LEAD(total_sales) OVER (ORDER BY sales_month),
     2
  ) AS next_month_sales
FROM monthly_sales
ORDER BY sales_month;


-- QUERY 63
-- Calculate month-over-month sales growth
WITH monthly_sales AS (
   SELECT
     DATE_TRUNC('month', o.order_date) AS sales_month,
     SUM(p.price * oi.quantity) AS total_sales
   FROM orders o
   JOIN order_items oi
     ON o.order_id = oi.order_id
   JOIN products p
     ON oi.product_id = p.product_id
   GROUP BY DATE_TRUNC('month', o.order_date)
),

sales_comparison AS (
  SELECT
    sales_month,
    total_sales,
    LAG(total_sales) OVER (
       ORDER BY sales_month
    ) AS previous_month_sales
  FROM monthly_sales
)

SELECT
  sales_month,
  ROUND(total_sales, 2) AS current_month_sales,
  ROUND(previous_month_sales, 2) AS previous_month_sales,
  ROUND(
     ((total_sales - previous_month_sales)
     / NULLIF(previous_month_sales, 0)) * 100,
     2
  ) AS growth_percentage
FROM sales_comparison
ORDER BY sales_month;


-- QUERY 64
-- Identify the top 3 products in each category by sales
WITH product_sales AS (
    SELECT
      p.product_id,
      p.product_name,
      p.category,
      SUM(p.price * oi.quantity) AS total_sales
    FROM products p
    JOIN order_items oi
      ON p.product_id = oi.product_id
    GROUP BY
      p.product_id,
      p.product_name,
      p.category
),

ranked_products AS (
  SELECT
    product_id,
    product_name,
    category,
    total_sales,
    DENSE_RANK() OVER (
      PARTITION BY category
      ORDER BY total_sales DESC
    ) AS sales_rank
  FROM product_sales
)

SELECT
  product_id,
  product_name,
  category,
  ROUND(total_sales, 2) AS total_sales,
  sales_rank
FROM ranked_products
WHERE sales_rank <= 3
ORDER BY category, sales_rank;

