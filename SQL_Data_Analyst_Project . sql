-- QUERY 1
CREATE TABLE customers (
   customer_id INT PRIMARY KEY,
   customer_name VARCHAR(100),
   email VARCHAR(150) UNIQUE,
   city VARCHAR(50),
   registration_date DATE
);


-- QUERY 2
INSERT INTO customers
(customer_id, customer_name, email, city, registration_date)
SELECT
  i,
  'Customer ' || i,
  'customer' || i || '@gmail.com',
  (ARRAY[
     'Delhi',
     'Mumbai',
     'Bangalore',
     'Chennai',
     'Kolkata',
     'Hyderabad',
     'Pune',
     'Jaipur',
     'Ahmedabad',
     'Lucknow'
  ])[1 + floor(random() * 10)::int],
  CURRENT_DATE - floor(random() * 1000)::int
FROM generate_series(1, 1000) AS i;


-- QUERY 3
SELECT * FROM customers;


-- QUERY 4
CREATE TABLE products (
   product_id INT PRIMARY KEY,
   product_name VARCHAR(100),
   category VARCHAR(50),
   price DECIMAL(10,2),
   cost DECIMAL(10,2)
);


-- QUERY 5
INSERT INTO products
(product_id, product_name, category, price, cost)
SELECT
  i,
  'Product ' || i,
  (ARRAY[
     'Electronics',
     'Clothing',
     'Home & Kitchen',
     'Beauty',
     'Sports',
     'Books',
     'Grocery',
     'Accessories'
  ])[1 + floor(random() * 8)::int],
  ROUND((500 + random() * 19500)::numeric, 2),
  ROUND((200 + random() * 12000)::numeric, 2)
FROM generate_series(1, 100) AS i;


-- QUERY 6
SELECT * FROM products;


-- QUERY 7
CREATE TABLE orders (
   order_id INT PRIMARY KEY,
   customer_id INT,
   order_date DATE,
   payment_method VARCHAR(30),
   FOREIGN KEY (customer_id) REFERENCES customers(customer_id)
);


-- QUERY 8
INSERT INTO orders
(order_id, customer_id, order_date, payment_method)
SELECT
  i,
  1 + floor(random() * 1000)::int,
  CURRENT_DATE - floor(random() * 730)::int,
  (ARRAY[
     'UPI',
     'Credit Card',
     'Debit Card',
     'Cash',
     'Net Banking'
  ])[1 + floor(random() * 5)::int]
FROM generate_series(1, 1000) AS i;


-- QUERY 9
SELECT * FROM orders;


-- QUERY 10
CREATE TABLE order_items (
  order_item_id INT PRIMARY KEY,
  order_id INT,
  product_id INT,
  quantity INT,
  FOREIGN KEY (order_id) REFERENCES orders(order_id),
  FOREIGN KEY (product_id) REFERENCES products(product_id)
);


